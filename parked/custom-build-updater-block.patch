diff --git a/packages/server/test/customBuildPolicy.test.ts b/packages/server/test/customBuildPolicy.test.ts
new file mode 100644
index 00000000..d18b2f15
--- /dev/null
+++ b/packages/server/test/customBuildPolicy.test.ts
@@ -0,0 +1,15 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import {
+    CUSTOM_BUILD_ID,
+    OFFICIAL_UPDATES_ENABLED,
+    officialUpdateDisabledMessage
+} from "../src/server/services/updateService/customBuildPolicy";
+
+test("custom builds cannot download or install an official update", () => {
+    assert.equal(CUSTOM_BUILD_ID, "swapnav/readsync-findmy-v199");
+    assert.equal(OFFICIAL_UPDATES_ENABLED, false);
+    assert.match(officialUpdateDisabledMessage(), /manual rebuild/i);
+    assert.match(officialUpdateDisabledMessage(), /swapnav\/readsync-findmy-v199/);
+});
